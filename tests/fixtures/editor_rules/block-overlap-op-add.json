{
  "description": "Adding a block on top of another block is rejected",
  "rule_id": "block_overlap",
  "family": "note-original",
  "schema_version": 1,
  "document": {
    "page": {
      "width": 1000,
      "background": {
        "kind": "blank"
      }
    },
    "items": [
      {
        "id": "t1",
        "kind": "text",
        "x": 40,
        "y": 40,
        "width": 200,
        "height": 100,
        "spans": [
          {
            "text": "Block t1"
          }
        ]
      }
    ]
  },
  "operation": {
    "op": "add",
    "item": {
      "id": "l1",
      "kind": "link_card",
      "x": 100,
      "y": 100,
      "width": 200,
      "height": 80,
      "url": "https://example.org/article"
    }
  },
  "expected": "invalid",
  "error": {
    "code": "block_overlap",
    "items": [
      "t1",
      "l1"
    ]
  }
}
