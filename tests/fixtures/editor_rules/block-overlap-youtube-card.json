{
  "description": "A youtube_card block overlaps a text block",
  "rule_id": "block_overlap",
  "family": "note-original",
  "schema_version": 1,
  "document": {
    "page": {
      "width": 800,
      "background": {
        "kind": "blank"
      }
    },
    "items": [
      {
        "id": "t1",
        "kind": "text",
        "x": 0,
        "y": 0,
        "width": 160,
        "height": 80,
        "spans": [
          {
            "text": "Block t1"
          }
        ]
      },
      {
        "id": "k1",
        "kind": "youtube_card",
        "x": 120,
        "y": 40,
        "width": 80,
        "height": 80,
        "url": "https://www.youtube.com/watch?v=abc123"
      }
    ]
  },
  "expected": "invalid",
  "error": {
    "code": "block_overlap",
    "items": [
      "t1",
      "k1"
    ]
  }
}
