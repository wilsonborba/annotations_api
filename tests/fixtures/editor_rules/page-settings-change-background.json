{
  "description": "A page step changes the background and keeps every item",
  "rule_id": "page_bounds",
  "family": "note-original",
  "schema_version": 1,
  "document": {
    "page": {
      "width": 1000,
      "background": {
        "kind": "blank"
      }
    },
    "items": [
      {
        "id": "t1",
        "kind": "text",
        "x": 600,
        "y": 0,
        "width": 200,
        "height": 100,
        "spans": [
          {
            "text": "Block t1"
          }
        ]
      }
    ]
  },
  "operation": {
    "op": "page",
    "page": {
      "width": 1000,
      "background": {
        "kind": "ruled",
        "spacing": 32,
        "visibility": 0.5
      }
    }
  },
  "expected": "valid"
}
