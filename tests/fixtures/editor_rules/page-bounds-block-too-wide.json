{
  "description": "A block reaches past the page width",
  "rule_id": "page_bounds",
  "family": "note-original",
  "schema_version": 1,
  "document": {
    "page": {
      "width": 1000,
      "background": {
        "kind": "blank"
      }
    },
    "items": [
      {
        "id": "t1",
        "kind": "text",
        "x": 801,
        "y": 0,
        "width": 200,
        "height": 100,
        "spans": [
          {
            "text": "Block t1"
          }
        ]
      }
    ]
  },
  "expected": "invalid",
  "error": {
    "code": "out_of_bounds",
    "items": [
      "t1"
    ]
  }
}
