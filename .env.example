# Private deployment values only. Application behaviour defaults live in core.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/asodya_annotations
COUCHDB_URL=http://HOST:5984
COUCHDB_DATABASE=annotations_documents
COUCHDB_USER=
COUCHDB_PASSWORD=
REDIS_URL=redis://HOST:6379/0
FSM_URL=http://HOST:8484
FSM_API_KEY=
# Optional Cortex service base URL; empty leaves Cortex content jobs off.
CORTEX_URL=
# Optional Plane Slim LAN base URL, API key, and workspace slug for task cards.
PLANE_URL=
# Optional central gateway base URL for waitlist forwarding.
GATEWAY_URL=
PLANE_API_KEY=
PLANE_WORKSPACE=asodya
# Disk-backed folder for upload staging before FSM; empty uses the system temp folder.
UPLOAD_STAGING_DIR=
HOST=127.0.0.1
PORT=8111
